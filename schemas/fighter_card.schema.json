{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "fighter_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "combat_identity": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "hands": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "defense": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stance": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "tie": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "kicking": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mentality": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "hands",
        "defense",
        "stance",
        "tie",
        "target",
        "kicking",
        "mentality"
      ],
      "additionalProperties": false
    },
    "adaptation": {
      "enum": [
        "boxing",
        "mma"
      ]
    },
    "orientation": {
      "enum": [
        "orthodox",
        "southpaw",
        "switching"
      ]
    },
    "slot_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "slot_label": {
      "enum": [
        "Brawler",
        "Two-piece",
        "Triad",
        "Anomaly"
      ]
    },
    "synchronized_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capabilities",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "baseline_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tempo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "preferred_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "outside",
          "kick",
          "punch",
          "close",
          "clinch",
          "ground"
        ]
      }
    },
    "debt_sentence": {
      "type": "string",
      "minLength": 1
    },
    "exploitable_seams": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_techniques": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditional_abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trained",
          "grants_capability",
          "techniques",
          "gates",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trained": {
            "const": true
          },
          "grants_capability": {
            "type": "string",
            "minLength": 1
          },
          "techniques": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "object",
            "required": [
              "range",
              "wall",
              "previous_setup"
            ],
            "properties": {
              "range": {
                "type": "string",
                "minLength": 1
              },
              "wall": {
                "const": "near"
              },
              "previous_setup": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "combat_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fighting_description": {
      "type": "object",
      "properties": {
        "does": {
          "type": "string",
          "minLength": 1
        },
        "wins": {
          "type": "string",
          "minLength": 1
        },
        "avoids": {
          "type": "string",
          "minLength": 1
        },
        "beaten_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "does",
        "wins",
        "avoids",
        "beaten_by"
      ],
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "required": [
        "clothing",
        "identity_anchor",
        "props"
      ],
      "properties": {
        "clothing": {
          "type": "string",
          "minLength": 1
        },
        "identity_anchor": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object"
    },
    "composites": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "version",
    "fighter_id",
    "name",
    "combat_identity",
    "dimensions",
    "adaptation",
    "orientation",
    "slot_count",
    "slot_label",
    "synchronized_capabilities",
    "baseline_capabilities",
    "tempo",
    "preferred_ranges",
    "debt_sentence",
    "exploitable_seams",
    "active_techniques",
    "conditional_abilities",
    "combat_limitations",
    "fighting_description",
    "appearance",
    "provenance"
  ],
  "additionalProperties": false
}
