{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "ruleset": {
      "enum": [
        "boxing",
        "mma"
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seed": {
      "type": "integer"
    },
    "selection": {
      "type": "object",
      "required": [
        "mode",
        "winner_id",
        "draw",
        "original_probabilities",
        "label"
      ],
      "properties": {
        "mode": {
          "enum": [
            "predictive",
            "director-controlled"
          ]
        },
        "winner_id": {
          "type": "string",
          "minLength": 1
        },
        "draw": {
          "type": "number"
        },
        "original_probabilities": {
          "type": "object"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "prediction": {
      "type": "object"
    },
    "initial_state": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "phase",
          "actor_id",
          "target_id",
          "technique_id",
          "timestamp",
          "duration",
          "cause_id",
          "dependencies",
          "source_weakness_ids",
          "intent",
          "preconditions",
          "parameters",
          "effects",
          "state_before",
          "state_after"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "assessment",
              "setup",
              "movement",
              "execution",
              "contact",
              "reaction",
              "recovery",
              "activation",
              "adjustment",
              "resolution",
              "aftermath"
            ]
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "technique_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cause_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_weakness_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "object"
          },
          "parameters": {
            "type": "object"
          },
          "effects": {
            "type": "object"
          },
          "state_before": {
            "type": "object"
          },
          "state_after": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "final_state": {
      "type": "object"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "geometry": {
      "type": "object"
    },
    "fidelity": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "ruleset",
    "duration",
    "seed",
    "selection",
    "cards",
    "prediction",
    "initial_state",
    "events",
    "final_state",
    "phases",
    "geometry",
    "fidelity",
    "conclusion"
  ],
  "additionalProperties": false
}
