{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "motion_trajectory": {
      "type": "string",
      "minLength": 1
    },
    "defensive_response": {
      "type": "string",
      "minLength": 1
    },
    "performance": {
      "type": "string",
      "minLength": 1
    },
    "environmental_reaction": {
      "type": "string",
      "minLength": 1
    },
    "lens_intent": {
      "type": "string",
      "minLength": 1
    },
    "animation_style": {
      "type": "string",
      "minLength": 1
    },
    "lighting": {
      "type": "string",
      "minLength": 1
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "starting_positions": {
      "type": "object"
    },
    "action_timing": {
      "type": "object"
    },
    "contact_timing": {
      "type": [
        "object",
        "null"
      ]
    },
    "camera": {
      "type": "object"
    },
    "continuity_constraints": {
      "type": "object"
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_visual_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "shot_id",
    "location",
    "required_action",
    "motion_trajectory",
    "defensive_response",
    "performance",
    "environmental_reaction",
    "lens_intent",
    "animation_style",
    "lighting",
    "source_event_ids",
    "duration",
    "characters",
    "starting_positions",
    "action_timing",
    "contact_timing",
    "camera",
    "continuity_constraints",
    "negative_constraints",
    "required_visual_references"
  ],
  "additionalProperties": false
}
