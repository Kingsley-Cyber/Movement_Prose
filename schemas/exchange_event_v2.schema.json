{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BLOCK Exchange Event v2 Schema",
  "type": "object",
  "required": [
    "exchange_index",
    "t_start",
    "t_end",
    "frames",
    "range",
    "lead_foot_matchup",
    "attacker_id",
    "defender_id",
    "active_slot_id",
    "technique_id",
    "attack_lane",
    "defender_posture_before",
    "defender_readiness_profile",
    "lane_readiness_score",
    "hit_probability",
    "outcome",
    "defense_used",
    "kick_anatomy",
    "damage",
    "counter_followup",
    "grappling_position",
    "state_changes"
  ],
  "properties": {
    "exchange_index": {"type": "integer", "minimum": 1},
    "t_start": {"type": "number", "minimum": 0},
    "t_end": {"type": "number", "minimum": 0},
    "frames": {"type": "integer", "minimum": 1},
    "range": {"type": "string"},
    "lead_foot_matchup": {"enum": ["closed_stance", "open_stance"]},
    "attacker_id": {"type": "string"},
    "defender_id": {"type": "string"},
    "active_slot_id": {"type": "string"},
    "technique_id": {"type": "string"},
    "attack_lane": {"type": "string"},
    "defender_posture_before": {"type": "object"},
    "defender_readiness_profile": {"type": "object"},
    "lane_readiness_score": {"type": "number"},
    "hit_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "outcome": {
      "enum": ["miss", "evaded", "caught", "checked", "jammed", "blocked", "partial", "clean", "counter_hit", "flush"]
    },
    "defense_used": {"type": ["string", "null"]},
    "kick_anatomy": {"type": ["object", "null"]},
    "damage": {"type": "object"},
    "counter_followup": {"type": ["object", "null"]},
    "grappling_position": {"type": "string"},
    "forced_stance_switch": {"type": "boolean"},
    "slot_switched_to": {"type": ["string", "null"]},
    "state_changes": {"type": "object"}
  }
}
